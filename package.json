{
  "name": "@ayonkhan/matinee",
  "version": "0.1.0",
  "description": "A mobile-first design system with Tailwind v4 tokens and JSX components. Built with Hono.",
  "keywords": [
    "design-system",
    "hono",
    "jsx",
    "tailwindcss",
    "ui-kit",
    "mobile-first",
    "components"
  ],
  "author": "Ayon Khan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayonkhan/matinee.git"
  },
  "bugs": "https://github.com/ayonkhan/matinee/issues",
  "homepage": "https://matinee.ayonkhan.ca",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite --config docs/vite.config.ts",
    "build": "tsdown",
    "docs:build": "vite build --config docs/vite.build.config.ts && tailwindcss -i docs/styles.css -o docs-dist/docs/styles.css --minify",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "hono": "^4",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@hono/vite-ssg": "^0.3.3",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "hono": "^4",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
